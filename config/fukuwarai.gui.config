<?xml version="1.0"?>
<window>
  <width>1000</width><height>845</height>
  <menus><drawer default="false"/></menus>
</window>
<plugin filename="GzScene3D" name="3D View">
  <ignition-gui><title>Fukuwarai</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></ignition-gui>
  <engine>ogre2</engine><scene>scene</scene>
  <ambient_light>0.65 0.65 0.65</ambient_light>
  <background_color>0.90 0.93 0.96</background_color>
  <camera_pose>0.23 -0.001 1.72 0 1.53 0</camera_pose>
</plugin>
<plugin filename="WorldControl" name="World control">
  <ignition-gui><title>World control</title><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property></ignition-gui>
  <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
</plugin>
<plugin filename="WorldStats" name="World stats">
  <ignition-gui><title>World stats</title><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property></ignition-gui>
  <sim_time>true</sim_time><real_time_factor>true</real_time_factor>
</plugin>
<plugin filename="EntityTree" name="Entity tree"/>
<plugin filename="InteractiveViewControl" name="Interactive view control"/>
<plugin filename="CameraTracking" name="Camera tracking"/>
